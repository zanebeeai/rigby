# Third-party robot descriptions are fetched at setup time and pinned by commit.
# Reference-only, per rigby_v2/rigging/references.py -- never vendored here.
rigby-generalized-urdf/assets/general/exotic/
# Same policy for the operator's own hardware: the KUKA meshes belong to
# ROS-Industrial and the uHand model is regenerated deterministically by
# scripts/build_irl.py, so neither needs to live in the history.
rigby-generalized-urdf/assets/general/irl/
_build/
rigby-humanoid/frontend/.vite/
