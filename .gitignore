__pycache__/
*.py[cod]
.pytest_cache/
.env
.venv/
node_modules/
dist/
*.egg-info/
.coverage
.playwright-mcp/
_build/

# humanoid: everything a run or a script regenerates.
humanoid/results/
humanoid/tmp/
humanoid/.ruff_cache/
humanoid/docs/plans/
humanoid/artifacts-v2/
humanoid/frontend/.vite/

# any-robot: everything a script can regenerate, plus the one thing
# licence terms forbid committing.
any-robot/results/
any-robot/robots/
any-robot/docs/media/
any-robot/.ruff_cache/
any-robot/frontend/.vite/
any-robot/*.log
any-robot/MUJOCO_LOG.TXT
# Third-party robot descriptions are fetched at setup time and pinned by commit.
# Reference-only, per rigby_v2/rigging/references.py -- never vendored here.
any-robot/assets/general/exotic/
# Same policy for the operator's own hardware: the KUKA meshes belong to
# ROS-Industrial and the uHand model is regenerated deterministically by
# scripts/build_irl.py, so neither needs to live in the history.
any-robot/assets/general/irl/

# Local agent worktrees and scratch

# G01 raw evidence is retained as verified compressed archives plus sealed media.
docs/results/g01-evidence/
