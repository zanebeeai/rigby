      ],
      "motion": "MOVE",
      "requires_ground": true,
      "description": "The Figure ends adjacent to the Ground without contacting it.",
      "contour": {
        "kind": "approach",
        "standoff_m": 0.05,
        "waypoints": [
          {
            "at": 0.0,
            "offset": [
              0.0,
