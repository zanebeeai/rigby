            ]
          }
        ]
      }
    },
    "AT": {
      "aliases": [
        "hold",
        "keep",
        "at",
        "stay"
      ],
      "motion": "BEL",
      "requires_ground": false,
      "description": "A located site. Talmy's limiting case of a PATH; the contour is a single point held over time.",
      "contour": {
        "kind": "site",
        "waypoints": [
          {
            "at": 0.0,
            "offset": [
              0.0,
              0.0,
              0.0
            ]
          },
          {
            "at": 1.0,
            "offset": [
              0.0,
              0.0,
              0.0
            ]
          }
        ]
      }
    }
  },
  "manners": {
    "GRASPED": {
      "aliases": [
        "grab",
        "grip",
        "hold",
        "carry",
        "pick up"
      ],
      "note": "The Figure is under continuous contact control by an effector.",
      "requires_contact": true
    },
    "PUSHED": {
      "aliases": [
        "push",
        "shove",
        "slide"
      ],
      "note": "The Figure is driven by contact but not enclosed.",
      "requires_contact": true
    },
    "THROWN": {
      "aliases": [
        "throw",
        "toss",
        "lob"
      ],
      "note": "Contact ends before the Path does; the Figure is ballistic thereafter.",
      "requires_contact": false
    },
    "DROPPED": {
      "aliases": [
        "drop",
        "release",
        "let go"
      ],
      "note": "Contact ends and the Figure falls under gravity alone.",
      "requires_contact": false
    }
  },
  "$alias_note": "Aliases are matched on word boundaries and the LONGEST match wins, so 'put down' resolves to DOWN rather than to ONTO's 'on'. Single prepositions are listed because English separates the verb from its path morpheme -- 'put the block on the ladder' has no contiguous 'put on'."
}
