{
  "schema_version": "1.0",
  "inventory_id": "rigby-general-schema-inventory-v1",
  "note": "The closed class. Nothing here names a robot, a joint, a link, or a unit. A robot is admitted to a schema by the capability it was measured to have, never by what it is called.",
  "requirements": {
    "grasping_effector": "At least one effector whose members were measured to converge.",
    "two_grasping_effectors": "Two such effectors, so one can act relative to the other.",
    "sensor": "A gaze source.",
    "confirmed_frame": "A person has confirmed which way the robot faces. Deixis is meaningless without it, and a guessed front renders a confidently backwards motion.",
    "contact_scene": "A scene object the effector can act on."
  },
  "path_schemas": [
