  ],
  "statives": [
    {
      "id": "orient_effector",
      "stative": "orient",
      "gloss": "turn the effector to an attitude without carrying it anywhere",
      "requires": [],
      "figure": "primary_effector",
      "ground": "base"
    },
    {
      "id": "hold_still",
      "stative": "hold",
      "gloss": "stay where it is; Talmy's located-ness rather than motion",
      "requires": [],
      "figure": "primary_effector",
      "ground": "base"
    },
    {
      "id": "press",
      "stative": "apply_force",
      "gloss": "bear on something already in contact",
      "requires": [
        "contact_scene"
      ],
      "figure": "primary_effector",
      "ground": "target_object"
    }
  ],
  "manner_axes": [
    {
      "name": "speed",
      "gloss": "how fast, relative to this robot's own comfortable pace"
    },
    {
      "name": "effort",
      "gloss": "how forcefully"
    },
    {
      "name": "smoothness",
      "gloss": "how evenly the motion is paced"
    },
    {
      "name": "rhythm",
      "gloss": "steady, accelerating, or pulsed"
    },
    {
      "name": "amplitude",
      "gloss": "how large, relative to this robot's own reach"
    },
    {
      "name": "repetition",
      "gloss": "how many times over, as an ordinal"
    },
    {
      "name": "precision",
      "gloss": "how exactly the endpoints must be hit"
    }
  ],
  "remove_fractions": {
    "coincident": 0.0,
    "adjacent": 0.1,
    "proximal": 0.32,
    "medial": 0.58,
    "distal": 0.84
  },
  "remove_fraction_note": "Fractions of this robot's measured reach radius. This single table is what makes one program serve a 0.39 m desktop arm and a 2.0 m long-reach arm: 'distal' is far for whichever body is asked.",
  "boundary_conditions": [
    "contact_made",
    "contact_broken",
    "direction_reversed",
    "orientation_set",
    "dwell",
    "terminus"
  ],
  "binding_note": "Each entry names its Figure and Ground roles. A path schema alone does not identify a motion: 'reach to a point' and 'hand it across' share the very same Path and differ only in what the Figure is located against. That is Talmy's decomposition taken literally, and it is why the retrieval key is schema plus roles rather than schema alone."
}
