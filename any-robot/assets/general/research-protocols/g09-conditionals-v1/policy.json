        "why": "a window in which a fifth of a sensor's samples are occluded or missing is not a window that sensor observed"
      },
      "task_policy": {
        "held.min_fraction": {
          "value": 0.95,
          "why": "a hold tolerates less than a grasp being formed"
        },
        "moving_with_robot.pairing_tolerance_s": {
          "value": 0.05,
          "why": "the camera's frame period plus its latency: the nearest effector sample to a frame"
        },
        "opposition_established.min_fraction": {
          "value": 0.9,
          "why": "opposition on nine tenths of the window's contact samples; the closure controller tolerates a tenth of a second of lost contact and so does the predicate"
        },
        "position_tolerance_m": {
          "value": 0.006,
          "why": "three standard deviations of the declared camera noise; containment and clearance are asked to that tolerance"
        },
        "stably_placed.max_speed_mps": {
          "value": 0.01,
          "why": "the registered placement goal's maximum linear speed; the predicate holds the object to the goal's own stillness"
        }
      },
      "windows": {
        "area_clear": {
          "duration_s": 0.5,
          "max_age_s": 0.2,
          "min_samples": 3,
          "why": "the region is clear when nothing was seen in it for half a second of frames"
        },
        "held": {
          "duration_s": 0.5,
          "max_age_s": 0.05,
          "min_samples": 5,
          "why": "as opposition; a hold is opposition that lasts"
        },
        "moving_with_robot": {
          "duration_s": 0.5,
          "max_age_s": 0.2,
          "min_samples": 5,
          "why": "half a second of travel at the carry's speed is centimetres, well above the camera's noise"
        },
        "opposition_established": {
          "duration_s": 0.5,
          "max_age_s": 0.05,
          "min_samples": 5,
          "why": "the closure's own hysteresis is a tenth of a second; half a second of contact at 200 Hz is a hundred samples, five the least that can show a fraction"
        },
        "reachable": {
          "duration_s": 0.5,
          "max_age_s": 0.2,
          "min_samples": 1,
          "why": "one fresh position and the calibrated shell decide reach; a fifth of a second is six camera frames"
        },
        "stably_placed": {
          "duration_s": 2.0,
          "max_age_s": 0.2,
          "min_samples": 10,
          "why": "the registered placement dwell is two seconds; the predicate asks for the same stillness the goal does"
        }
      }
